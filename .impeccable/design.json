  "narrative": {
    "northStar": "The Geometric Editorial Studio",
    "overview": "Kubo Web combines the confidence of an editorial studio with the precision of a digital craft practice. Dark, spacious fields carry large geometric type; selective serif italics add a human inflection. Lavender connects the fine geometry, small details, and decisive actions. Pale sections introduce a deliberate change in reading pace.\n\nThis system records the implemented homepage in `src/pages/StudioHome.tsx`, `src/styles/studio.css`, and `src/components/LineSculpture.tsx`. Existing internal routes retain earlier styling and are not yet fully migrated. Use this world as the reference for intentional future migrations; do not treat incumbent inner-route styles as tokens of this system. The homepage composition is recorded separately in `.impeccable/surfaces/home.md`.",
    "keyCharacteristics": [
      "Spacious editorial hierarchy with compact supporting labels.",
      "Geometric linework paired with restrained lavender accents.",
      "Mostly flat surfaces, thin rules, and small functional corners.",
      "Real project imagery and clear, keyboard-accessible interactions."
    ],
    "rules": [
      {
        "name": "The Surface Pairing Rule",
        "body": "Switch both background and text roles when entering a pale region. Keep muted copy appropriate to its local surface.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Use Space Grotesk for the main statement and Playfair italics for a chosen phrase; retain DM Sans for functional reading.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do use the studio palette and local surface text pairings.",
      "Do retain the geometric sans, serif italic, and clear body-type relationship.",
      "Do preserve keyboard focus, tab navigation, native disclosure behavior, and reduced motion.",
      "Do use verified project screenshots and recognizable project content.",
      "Do migrate existing internal routes deliberately, with their behavior preserved."
    ],
    "donts": [
      "Don't turn every section into a raised card or add pervasive shadows.",
      "Don't spread decorative serif italics into navigation or body paragraphs.",
      "Don't substitute invented clients, testimonials, results, or unsupported brand marks for evidence.",
      "Don't assume internal routes already implement this visual system."
    ]
  }
