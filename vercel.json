{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "kuboweb.com.br" }],
      "destination": "https://www.kuboweb.com.br/:path*",
      "permanent": true
    },
    {
      "source": "/portfolio/:slug",
      "destination": "/portfolio",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sobre", "destination": "/sobre/index.html" },
    { "source": "/servicos", "destination": "/servicos/index.html" },
    { "source": "/portfolio", "destination": "/portfolio/index.html" },
    { "source": "/diagnostico", "destination": "/diagnostico/index.html" },
    { "source": "/faq", "destination": "/faq/index.html" },
    { "source": "/contato", "destination": "/contato/index.html" },
    { "source": "/servicos/sites-institucionais", "destination": "/servicos/sites-institucionais/index.html" },
    { "source": "/servicos/landing-pages", "destination": "/servicos/landing-pages/index.html" },
    { "source": "/servicos/loja-virtual", "destination": "/servicos/loja-virtual/index.html" },
    { "source": "/servicos/anuncios", "destination": "/servicos/anuncios/index.html" },
    { "source": "/manutencao", "destination": "/manutencao/index.html" },
    { "source": "/atendimento", "destination": "/atendimento/index.html" },
    { "source": "/criacao-de-sites-:slug", "destination": "/criacao-de-sites-:slug/index.html" },
    { "source": "/guia/investimento-site-profissional", "destination": "/guia/investimento-site-profissional/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(webp|avif|png|jpg|jpeg|svg|ico|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
